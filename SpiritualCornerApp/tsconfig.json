{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components": ["src/components"],
      "@/screens": ["src/screens"],
      "@/navigation": ["src/navigation"],
      "@/hooks": ["src/hooks"],
      "@/utils": ["src/utils"],
      "@/services": ["src/services"],
      "@/types": ["src/types"],
      "@/constants": ["src/constants"],
      "@/assets/*": ["src/assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
